---
import Base from '../layouts/Base.astro'
---

<Base title="404 — Gangadhar Yadav" description="Page not found.">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-32 text-center">
    <p class="font-mono text-7xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-xl font-semibold text-heading">Page not found</h1>
    <p class="mt-2 text-text-secondary">The page you are looking for doesn't exist.</p>
    <a
      href="/"
      class="mt-8 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent"
    >
      Go home
    </a>
  </div>
</Base>

---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Icons from '../components/Icons.astro'
import { site } from '../data/site'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}
---

<Base title={site.name}>
  <div class="mx-auto max-w-5xl px-6">

    <!-- Hero -->
    <section class="flex flex-col justify-center pb-20 pt-16 sm:pt-24">
      <div class="flex items-center gap-2.5 text-sm text-text-secondary">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
        </span>
        <span>Available for opportunities</span>
      </div>

      <h1 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-heading sm:text-6xl">
        Hi, I'm <span class="text-accent">Gangadhar</span>
      </h1>

      <p class="mt-4 max-w-lg text-lg text-text-secondary sm:text-xl">
        {site.tagline}
      </p>

      <div class="mt-8 flex items-center gap-4">
        {site.socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noreferrer' : undefined}
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-text-secondary transition-all hover:border-border-hover hover:text-accent"
            aria-label={s.label}
          >
            <Icons name={s.icon} class="h-[18px] w-[18px]" />
          </a>
        ))}
      </div>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 gap-4 pb-20 sm:grid-cols-4">
      {site.highlights.map((h) => (
        <div class="rounded-xl border border-border bg-card p-5 text-center">
          <p class="font-mono text-2xl font-bold text-accent">{h.value}</p>
          <p class="mt-1 text-xs text-text-secondary">{h.label}</p>
        </div>
      ))}
    </section>

    <!-- Experience -->
    <section id="experience" class="scroll-mt-24 pb-20">
      <h2 class="mb-8 text-sm font-semibold uppercase tracking-widest text-text-secondary">
        Experience
      </h2>
      <div class="space-y-4">
        {site.experience.map((job) => (
          <div class="group rounded-xl border border-border bg-card p-5 transition-colors hover:border-border-hover">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="font-semibold text-heading">{job.role}</h3>
                <p class="text-sm text-accent">{job.org}</p>
              </div>
              <span class="rounded-full border border-border px-3 py-0.5 font-mono text-xs text-text-secondary">
                {job.dates}
              </span>
            </div>
            <p class="mt-3 text-sm text-text-secondary">{job.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="scroll-mt-24 pb-20">
      <h2 class="mb-8 text-sm font-semibold uppercase tracking-widest text-text-secondary">
        Projects
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {site.projects.map((project) => (
          <div class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-border-hover">
            <div class="flex items-start justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-dim font-mono text-sm font-bold text-accent">
                {project.title[0]}
              </div>
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  class="text-text-secondary transition-colors hover:text-accent"
                  aria-label={`View ${project.title}`}
                >
                  <Icons name="arrow-up-right" class="h-4 w-4" />
                </a>
              )}
            </div>
            <h3 class="mt-4 font-semibold text-heading">{project.title}</h3>
            <p class="text-xs text-accent">{project.subtitle}</p>
            <p class="mt-2 flex-1 text-sm text-text-secondary">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[11px] text-text-secondary">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="pb-20">
      <h2 class="mb-8 text-sm font-semibold uppercase tracking-widest text-text-secondary">
        Tech Stack
      </h2>
      <div class="flex flex-wrap gap-2">
        {site.skills.map((skill) => (
          <span class="rounded-lg border border-border bg-card px-3.5 py-2 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <!-- Blog preview -->
    {posts.length > 0 && (
      <section class="pb-20">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-text-secondary">
            Recent Posts
          </h2>
          <a href="/blog" class="font-mono text-xs text-accent transition-colors hover:text-accent/80">
            View all &rarr;
          </a>
        </div>
        <div class="space-y-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex items-center justify-between rounded-xl border border-border bg-card px-5 py-4 transition-colors hover:border-border-hover"
            >
              <div>
                <h3 class="font-semibold text-heading transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="mt-0.5 text-sm text-text-secondary">{post.data.description}</p>
                )}
              </div>
              <time class="hidden shrink-0 font-mono text-xs text-text-secondary sm:block">
                {formatDate(post.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

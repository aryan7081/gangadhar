---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}
---

<Base title="Blog — Gangadhar Yadav" description="Notes on engineering, systems, and things I learn along the way.">
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">Blog</h1>
    <p class="mt-3 text-text-secondary">
      Notes on engineering, systems, and things I learn along the way.
    </p>

    {posts.length === 0 ? (
      <p class="mt-16 text-text-secondary">No posts yet.</p>
    ) : (
      <div class="mt-12 space-y-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-border-hover sm:flex-row sm:items-center sm:justify-between"
          >
            <div class="min-w-0 flex-1">
              <h2 class="font-semibold text-heading transition-colors group-hover:text-accent">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="mt-1 text-sm text-text-secondary">{post.data.description}</p>
              )}
              {post.data.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[11px] text-text-secondary">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <time class="mt-3 shrink-0 font-mono text-xs text-text-secondary sm:mt-0 sm:ml-6">
              {formatDate(post.data.date)}
            </time>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>

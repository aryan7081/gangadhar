---
import { site } from '../data/site'
import Icons from './Icons.astro'
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-10 sm:flex-row sm:justify-between">
    <div class="flex items-center gap-4">
      {site.socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noreferrer' : undefined}
          class="text-text-secondary transition-colors hover:text-accent"
          aria-label={s.label}
        >
          <Icons name={s.icon} class="h-[18px] w-[18px]" />
        </a>
      ))}
    </div>
    <p class="font-mono text-xs text-text-secondary">
      &copy; {new Date().getFullYear()} {site.name}
    </p>
  </div>
</footer>
